{
  "$schema": "https://developers.cloudflare.com/wrangler/config-schema.json",
  "name": "starting9-auth",
  "main": "auth-worker.js",
  "compatibility_date": "2026-07-17",
  "workers_dev": true,
  "vars": {
    "AUTH_ALLOWED_ORIGINS": "https://REPLACE_WITH_FRONTEND_ORIGIN",
    "SESSION_SAMESITE": "Lax",
    "AUTO_SCORING_DELAY_SECONDS": "300",
    "ENABLE_DEVELOPMENT_MODE": "false",
    "ENABLE_WORKFLOW_COMPLETION_JOBS": "true",
    "ENABLE_GAME_AUTOMATION_V3": "false"
  },
  "services": [
    {
      "binding": "NPB_FETCH_WORKER",
      "service": "starting9-npb-fetch"
    }
  ],
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "starting9-auth",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ]
}
