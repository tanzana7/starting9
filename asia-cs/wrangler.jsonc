{
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "starting9-asia-cs-api",
  "main": "./worker.js",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "ALLOWED_ORIGIN": "http://localhost:8782",
    "ADMIN_USERNAMES": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "starting9-asia-cs-db",
      "database_id": "REPLACE_WITH_ASIA_CS_D1_ID",
      "migrations_dir": "./migrations"
    }
  ]
}
