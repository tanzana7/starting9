{
  "$schema": "https://developers.cloudflare.com/wrangler/config-schema.json",
  "name": "starting9-auth",
  "main": "auth-worker.js",
  "account_id": "02580fab1c09e144db7da89478e252c8",
  "compatibility_date": "2026-07-17",
  "workers_dev": true,
  "triggers": {
    "crons": []
  },
  "vars": {
    "AUTH_ALLOWED_ORIGINS": "https://starting9.pages.dev",
    "SESSION_SAMESITE": "None",
    "AUTO_SCORING_DELAY_SECONDS": "300",
    "ENABLE_DEVELOPMENT_MODE": "false",
    "ENABLE_WORKFLOW_COMPLETION_JOBS": "true",
    "ENABLE_GAME_AUTOMATION_V3": "true",
    "ENABLE_AUTO_PROBABLE_STARTER": "true",
    "ENABLE_AUTO_ROSTER_FETCH": "false",
    "ENABLE_AUTO_LINEUP_FETCH": "false",
    "ENABLE_LINEUP_SHADOW": "true",
    "ENABLE_SEMI_AUTO_LINEUP": "true",
    "PUBLIC_RANKING_RELEASED_AT": "2026-09-21T00:00:00+09:00",
    "NPB_FETCH_DISABLED": "false",
    "MIGRATION_MAINTENANCE": "true"
  },
  "services": [
    {
      "binding": "ASIA_CS_SERVICE",
      "service": "starting9-asia-cs-api"
    },
    {
      "binding": "NPB_FETCH_WORKER",
      "service": "starting9-npb-fetch"
    }
  ],
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "starting9-auth-prod",
      "database_id": "326f97c3-768d-4df6-ada2-129fdb1865a1",
      "migrations_dir": "migrations"
    },
    {
      "binding": "AUDIT_DB",
      "database_name": "starting9-audit-prod",
      "database_id": "acfac47d-1963-433a-b16b-36cd3afe9db4",
      "migrations_dir": "migrations-audit"
    }
  ]
}
